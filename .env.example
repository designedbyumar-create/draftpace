NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Required for the notifications cron evaluator to query
# reminders across all users (a cron job has no authenticated session, so
# RLS's auth.uid() has nothing to check against — this key is how the
# evaluator legitimately bypasses RLS instead of impersonating a user).
# From Supabase dashboard -> Project Settings -> API -> service_role key.
# Never expose this to the client bundle.
SUPABASE_SERVICE_ROLE_KEY=

# Web Push (VAPID). Generate with `npx web-push generate-vapid-keys`.
# The public key is safe to expose to the browser (NEXT_PUBLIC_ prefix is
# correct here); the private key must stay server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Shared secret the Vercel Cron job sends as `Authorization: Bearer
# <value>` when it calls /api/notifications/cron. Generate any long random
# string (e.g. `openssl rand -hex 32`); must match exactly in Vercel.
CRON_SECRET=

# Same idea as CRON_SECRET above, but for Home Base's own, separate
# /api/notifications/cron-hmc evaluator - a distinct value on purpose, so
# rotating one product's cron secret never affects the other's. Must
# match the 'hmc_cron_secret' Vault secret referenced by
# 202608190005_home_management_companion_cron_schedule.sql.
HMC_CRON_SECRET=

# Same idea again, for the combined /api/notifications/cron-life-updates
# evaluator (Alongside, Homeschooling Companion, Travel Companion,
# Personal Life Affairs Companion — the four products with no push
# infrastructure of their own; this route only writes to the Updates
# feed, never sends push). Must match the 'life_updates_cron_secret'
# Vault secret referenced by 202609060001_life_updates_cron_schedule.sql.
LIFE_UPDATES_CRON_SECRET=
