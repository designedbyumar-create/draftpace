NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Required for the notifications cron evaluator to query
# reminders across all users (a cron job has no authenticated session, so
# RLS's auth.uid() has nothing to check against — this key is how the
# evaluator legitimately bypasses RLS instead of impersonating a user).
# From Supabase dashboard -> Project Settings -> API -> service_role key.
# Never expose this to the client bundle.
SUPABASE_SERVICE_ROLE_KEY=

# Web Push (VAPID). Generate with `npx web-push generate-vapid-keys`.
# The public key is safe to expose to the browser (NEXT_PUBLIC_ prefix is
# correct here); the private key must stay server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Shared secret the Vercel Cron job sends as `Authorization: Bearer
# <value>` when it calls /api/notifications/cron. Generate any long random
# string (e.g. `openssl rand -hex 32`); must match exactly in Vercel.
CRON_SECRET=

# Same idea as CRON_SECRET above, but for Home Base's own, separate
# /api/notifications/cron-hmc evaluator - a distinct value on purpose, so
# rotating one product's cron secret never affects the other's. Must
# match the 'hmc_cron_secret' Vault secret referenced by
# 202608190005_home_management_companion_cron_schedule.sql.
HMC_CRON_SECRET=

# Same idea again, for the combined /api/notifications/cron-life-updates
# evaluator (Alongside, Homeschooling Companion, Travel Companion,
# Personal Life Affairs Companion — the four products with no push
# infrastructure of their own; this route only writes to the Updates
# feed, never sends push). Must match the 'life_updates_cron_secret'
# Vault secret referenced by 202609060001_life_updates_cron_schedule.sql.
LIFE_UPDATES_CRON_SECRET=

# ---------------------------------------------------------------------------
# LEMON SQUEEZY
# ---------------------------------------------------------------------------
# Draftpace sells through Lemon Squeezy, which acts as merchant of record
# and handles VAT/GST. The purchase flow is:
#
#   Shop page -> overlay checkout (lemon.js) -> payment -> order_created
#   webhook -> grant_purchased_product -> /app/welcome/<slug>
#
# THE ONLY SECRET HERE IS THE WEBHOOK SIGNING KEY.
# Buy Links and variant ids are identifiers, not secrets: they are in the
# page HTML for anyone to read, and live in code (src/shop/
# lemonSqueezyCheckout.ts and src/shop/lemonSqueezyVariants.ts) with these
# variables as per-deployment overrides. Set the overrides only for a
# staging deployment pointed at Lemon Squeezy test mode, where the ids are
# genuinely different objects.

# REQUIRED IN PRODUCTION. Without it /api/lemon-squeezy/webhook returns 503
# and no purchase is ever granted: the customer is charged and gets
# nothing. Must match the signing secret on the webhook exactly
# (Lemon Squeezy -> Settings -> Webhooks), which is subscribed to
# order_created and points at https://<your-domain>/api/lemon-squeezy/webhook
LEMON_SQUEEZY_WEBHOOK_SECRET=

# Optional per-product overrides. A Buy Link ends in a variant UUID
# (.../checkout/buy/<uuid>); the VARIANT_ID is the separate numeric id the
# webhook payload carries (Lemon Squeezy -> Products -> menu -> Copy
# variant ID). They are different identifiers for the same variant and are
# not interchangeable.
LEMON_SQUEEZY_PFC_CHECKOUT_URL=
LEMON_SQUEEZY_PFC_VARIANT_ID=
LEMON_SQUEEZY_HMC_CHECKOUT_URL=
LEMON_SQUEEZY_HMC_VARIANT_ID=
LEMON_SQUEEZY_PLA_CHECKOUT_URL=
LEMON_SQUEEZY_PLA_VARIANT_ID=
LEMON_SQUEEZY_HSC_CHECKOUT_URL=
LEMON_SQUEEZY_HSC_VARIANT_ID=
LEMON_SQUEEZY_ALONGSIDE_CHECKOUT_URL=
LEMON_SQUEEZY_ALONGSIDE_VARIANT_ID=
LEMON_SQUEEZY_TRAVEL_CHECKOUT_URL=
LEMON_SQUEEZY_TRAVEL_VARIANT_ID=
LEMON_SQUEEZY_VMC_CHECKOUT_URL=
LEMON_SQUEEZY_VMC_VARIANT_ID=
LEMON_SQUEEZY_FHB_CHECKOUT_URL=
LEMON_SQUEEZY_FHB_VARIANT_ID=

# ---------------------------------------------------------------------------
# SITE AND TOOLING
# ---------------------------------------------------------------------------

# The deployment's own origin, used for canonical URLs, the sitemap, and
# the checkout success_url that returns a buyer to /app/welcome/<slug>.
# Defaults to https://draftpace.com when unset, so a preview deployment
# must set it or it will send buyers to production.
NEXT_PUBLIC_SITE_URL=

# Google Search Console verification token, rendered as a meta tag.
GOOGLE_SITE_VERIFICATION=

# Development only. Registers the four internal product fixtures, which
# are excluded from the registry, the sitemap and robots in production.
# Never set this in production.
NEXT_PUBLIC_DEV_FIXTURES=

# Makes /admin reachable in a production build. /admin is reachable
# automatically when NODE_ENV !== "production"; this is the escape hatch
# for testing it against a real build. It must be present in the running
# process's environment at request time, not only at build time.
DRAFTPACE_ADMIN_PREVIEW=
