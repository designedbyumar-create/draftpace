      "number": {
        "text": "2",
        "source": "micro"
      },
      "head": {
        "text": "Write down when each job was last done and the odometer reading at the time.",
        "source": "guide:what-is-due-on-my-car-right-now/body[3].items[1]#0"
      },
      "body": [
        {
          "text": "A receipt, a sticker on the windshield or a shop's records can supply it.",
          "source": "guide:what-is-due-on-my-car-right-now/body[3].items[1]#1"
        },
        {
          "text": "If you did it yourself, your own note does.",
