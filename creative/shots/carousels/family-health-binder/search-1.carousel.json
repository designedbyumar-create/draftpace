  "slides": [
    {
      "kind": "cover",
      "quote": {
        "text": "I can never remember my child's medications at the doctor",
        "source": "searchedProblems[0].phrase"
      },
      "emphasis": [
        "medications"
      ],
      "promise": {
        "text": "How to keep a family medication list",
        "source": "guide:medication-list-what-to-write-down/title"
      }
    },
    {
      "kind": "answer",
      "eyebrow": {
        "text": "In short",
        "source": "micro"
      },
      "lines": [
        {
          "text": "Name, dose and how often, copied exactly as the label says, plus the date the list was last right.",
          "source": "guide:medication-list-what-to-write-down/dek#0"
        },
        {
          "text": "Always follow your prescriber or pharmacist.",
          "source": "guide:medication-list-what-to-write-down/dek#1"
        }
      ]
    },
    {
      "kind": "step",
      "eyebrow": {
        "text": "How to write it",
        "source": "guide:medication-list-what-to-write-down/body[3].heading"
      },
      "number": {
        "text": "1",
        "source": "micro"
      },
      "head": {
        "text": "Line up everything the person takes: prescriptions, inhalers, eye drops, creams, patches, over-the-counter pills, vitamins and herbal products.",
        "source": "guide:medication-list-what-to-write-down/body[3].items[0]#0"
      },
      "body": [
        {
          "text": "The FDA says to include the ones used only some of the time.",
          "source": "guide:medication-list-what-to-write-down/body[3].items[0]#1"
        }
      ],
      "emphasis": [
        "prescriptions"
      ]
    },
    {
      "kind": "step",
      "eyebrow": {
        "text": "How to write it",
        "source": "guide:medication-list-what-to-write-down/body[3].heading"
      },
      "number": {
        "text": "2",
        "source": "micro"
      },
      "head": {
        "text": "Copy the name and strength from the label, letter for letter.",
        "source": "guide:medication-list-what-to-write-down/body[3].items[1]#0"
      },
      "body": [
        {
          "text": "If the label says \"500 mg,\" write 500 mg.",
          "source": "guide:medication-list-what-to-write-down/body[3].items[1]#1"
        }
      ],
      "emphasis": [
        "strength"
      ]
    },
    {
      "kind": "step",
      "eyebrow": {
        "text": "How to write it",
        "source": "guide:medication-list-what-to-write-down/body[3].heading"
      },
      "number": {
        "text": "3",
        "source": "micro"
      },
      "head": {
        "text": "Copy the directions the same way.",
        "source": "guide:medication-list-what-to-write-down/body[3].items[2]#0"
      },
      "body": [
        {
          "text": "Don't shorten \"with food\" to nothing.",
          "source": "guide:medication-list-what-to-write-down/body[3].items[2]#1"
        }
      ],
      "emphasis": [
        "directions"
      ]
    },
    {
      "kind": "step",
      "eyebrow": {
        "text": "How to write it",
        "source": "guide:medication-list-what-to-write-down/body[3].heading"
      },
      "number": {
        "text": "4",
        "source": "micro"
      },
      "head": {
        "text": "Write what it's for in the prescriber's or pharmacist's words.",
        "source": "guide:medication-list-what-to-write-down/body[3].items[3]#0"
      },
      "body": [
        {
          "text": "If you don't know, ask them at the next visit and leave the space empty until then.",
          "source": "guide:medication-list-what-to-write-down/body[3].items[3]#1"
        }
      ],
      "emphasis": [
        "words"
      ]
    },
    {
      "kind": "step",
      "eyebrow": {
        "text": "How to write it",
        "source": "guide:medication-list-what-to-write-down/body[3].heading"
      },
      "number": {
        "text": "5",
        "source": "micro"
      },
      "head": {
        "text": "Put allergies at the top, and say what the reaction was.",
        "source": "guide:medication-list-what-to-write-down/body[3].items[4]#0"
      },
      "body": [],
      "emphasis": [
        "allergies"
      ]
    },
    {
      "kind": "help",
      "eyebrow": {
        "text": "How it helps",
        "source": "micro"
      },
      "name": {
        "text": "Family Health Binder",
        "source": "title"
      },
      "line": {
        "text": "They are written down per person, with dose and how often, on whatever device is in your hand at the desk, and stopped ones leave the list.",
        "source": "searchedProblems[0].answer"
