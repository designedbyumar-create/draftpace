{
  "name": "Draftpace",
  "short_name": "Draftpace",
  "description": "Draftpace is a platform for interactive, personalized digital products that keep you moving forward.",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "background_color": "#FAFAF7",
  "theme_color": "#3730A3",
  "orientation": "portrait-primary",
  "categories": ["productivity", "lifestyle"],
  "icons": [
    {
      "src": "/logo/dp-monogram-indigo.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/logo/dp-monogram-dark.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Home",
      "short_name": "Home",
      "url": "/app",
      "description": "Open Draftpace"
    },
    {
      "name": "Library",
      "short_name": "Library",
      "url": "/app/library",
      "description": "Open your products"
    }
  ]
}
