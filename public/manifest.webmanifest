{
  "name": "Draftpace",
  "short_name": "Draftpace",
  "description": "Draftpace is a platform for interactive, personalized digital products that keep you moving forward.",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "background_color": "#f4f2ec",
  "theme_color": "#0e6e75",
  "orientation": "portrait-primary",
  "categories": ["productivity", "lifestyle"],
  "icons": [
    {
      "src": "/logo/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/logo/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/logo/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Home",
      "short_name": "Home",
      "url": "/app",
      "description": "Open Draftpace"
    },
    {
      "name": "Library",
      "short_name": "Library",
      "url": "/app/library",
      "description": "Open your products"
    }
  ]
}
